# Dockerfile for Occupancy Networks (Ubuntu 22.04, Python 3.10, GPU-enabled)
FROM nvcr.io/nvidia/cuda:11.8.0-devel-ubuntu22.04

LABEL maintainer="Your Name <your.email@example.com>"
LABEL description="Build environment for Occupancy Networks (GPU version) with Python 3.10."

# set environment variables to avoid interactive prompts and ensure UTF-8
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# install system dependencies (Python 3.10 comes with Ubuntu 22.04)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        build-essential \
        git \
        libomp-dev \
        curl \
        pkg-config \
        ninja-build \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# set up python3 symlinks for convenience
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

# Create and use a virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# upgrade pip and install basic build tools
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# install PyTorch with CUDA 11.8 support
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# install numpy and ensure headers are available
RUN pip install --no-cache-dir numpy

# install remaining dependencies including modern replacements
RUN pip install --no-cache-dir \
        scipy \
        cython \
        h5py \
        Pillow \
        scikit-image \
        imageio \
        matplotlib \
        pandas \
        PyYAML \
        tensorboard \
        tqdm \
        trimesh \
        plyfile \
        pytest \
        pykdtree \
        PyMCubes

# CUDA environment variables
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# set final working directory / copy repo into container
WORKDIR /app/occupancy_networks
COPY eval_meshes.py eval.py generate.py train.py setup.py /app/occupancy_networks/
COPY configs /app/occupancy_networks/configs
COPY demo /app/occupancy_networks/demo
COPY external /app/occupancy_networks/external
COPY im2mesh /app/occupancy_networks/im2mesh
COPY img /app/occupancy_networks/img
COPY scripts /app/occupancy_networks/scripts

# Remove the problematic local libraries
RUN rm -rf /app/occupancy_networks/im2mesh/utils/libkdtree
RUN rm -rf /app/occupancy_networks/im2mesh/utils/libmcubes

# Create directories for persistent data
RUN mkdir -p /app/occupancy_networks/cache/models
RUN mkdir -p /app/occupancy_networks/cache/compiled

# Create compilation and model download script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
cd /app/occupancy_networks\n\
\n\
# Check if already compiled\n\
if [ ! -f cache/compiled/.compiled ]; then\n\
    echo "Compiling Cython/C++ extensions..."\n\
    python3 setup.py build_ext --inplace\n\
    mkdir -p cache/compiled\n\
    touch cache/compiled/.compiled\n\
    echo "Compilation complete."\n\
fi\n\
\n\
exec "$@"' > /usr/local/bin/setup.sh && \
chmod +x /usr/local/bin/setup.sh

ENTRYPOINT ["/usr/local/bin/setup.sh"]
CMD ["/bin/bash"]
