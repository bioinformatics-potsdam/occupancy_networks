# Dockerfile for Occupancy Networks (Ubuntu 20.04, Python 3.6, GPU-enabled)
FROM nvidia/cuda:11.8.0-devel-ubuntu20.04

LABEL maintainer="Your Name <your.email@example.com>"
LABEL description="Build environment for Occupancy Networks (GPU version) with specific Python dependencies and fixes for compilation and import errors."

# set environment variables to avoid interactive prompts and ensure UTF-8
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# install system dependencies including Python 3.6 (need to add deadsnakes PPA for Ubuntu 20.04)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.6 \
        python3.6-dev \
        python3.6-distutils \
        python3-pip \
        build-essential \
        git \
        libomp-dev \
        curl \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install pip for Python 3.6
RUN curl https://bootstrap.pypa.io/pip/3.6/get-pip.py -o get-pip.py && \
    python3.6 get-pip.py && \
    rm get-pip.py

# set up python3.6 as the default python3 and pip3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.6 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/local/bin/pip3.6 1

# upgrade pip and install basic build tools
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir wheel setuptools

# install Python dependencies with newer PyTorch
RUN python3 -m pip install --no-cache-dir torch==1.7.1+cu110 torchvision==0.8.2+cu110 -f https://download.pytorch.org/whl/torch_stable.html
RUN python3 -m pip install --no-cache-dir numpy==1.15.4

# --- WORKAROUND: Find and copy NumPy headers to global include path ---
RUN NUMPY_PATH=$(python3 -c "import numpy; print(numpy.__path__[0])") && \
    echo "NumPy installed at: $NUMPY_PATH" && \
    cp -r "$NUMPY_PATH/core/include/numpy" /usr/local/include/numpy

# install remaining dependencies
RUN python3 -m pip install --no-cache-dir \
        scipy==1.1.0 \
        cython==0.29.2 \
        h5py==2.9.0 \
        Pillow==5.3.0 \
        scikit-image==0.14.1 \
        imageio==2.4.1 \
        matplotlib==3.0.3 \
        pandas==0.23.4 \
        PyYAML==3.13 \
        tensorboardX==1.4 \
        tqdm==4.28.1 \
        trimesh==2.37.7 \
        plyfile==0.7 \
        pytest==4.0.2

# CUDA environment variables
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# set final working directory / copy repo into container
WORKDIR /app/occupancy_networks
COPY eval_meshes.py eval.py generate.py setup.py train.py /app/occupancy_networks/
COPY configs /app/occupancy_networks/configs
COPY demo /app/occupancy_networks/demo
COPY external /app/occupancy_networks/external
COPY im2mesh /app/occupancy_networks/im2mesh
COPY img /app/occupancy_networks/img
COPY scripts /app/occupancy_networks/scripts

# Create directories for persistent data
RUN mkdir -p /app/occupancy_networks/cache/models
RUN mkdir -p /app/occupancy_networks/cache/compiled

# Create compilation and model download script with proper PATH
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Ensure proper PATH for python3\n\
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"\n\
\n\
# Source environment if needed\n\
if [ -f /etc/environment ]; then\n\
    set -a\n\
    source /etc/environment\n\
    set +a\n\
fi\n\
\n\
cd /app/occupancy_networks\n\
\n\
# Check if already compiled\n\
if [ ! -f cache/compiled/.compiled ]; then\n\
    echo "Compiling Cython/C++ extensions..."\n\
    /usr/bin/python3 setup.py build_ext --inplace\n\
    mkdir -p cache/compiled\n\
    touch cache/compiled/.compiled\n\
    echo "Compilation complete."\n\
fi\n\
\n\
# Check if model already downloaded\n\
if [ ! -f cache/models/.downloaded ]; then\n\
    echo "Downloading model..."\n\
    /usr/bin/python3 generate.py configs/demo.yaml --no-cuda\n\
    mkdir -p cache/models\n\
    touch cache/models/.downloaded\n\
    echo "Model download complete."\n\
fi\n\
\n\
exec "$@"' > /usr/local/bin/setup.sh && \
chmod +x /usr/local/bin/setup.sh

ENTRYPOINT ["/usr/local/bin/setup.sh"]
CMD ["/bin/bash"]
